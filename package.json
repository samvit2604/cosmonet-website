{
  "name": "cosmonet-website",
  "version": "1.0.0",
  "private": true,
  "description": "Cosmonet website and durable Resend enquiry service",
  "scripts": {
    "dev": "node --watch server/dev.js",
    "build": "python3 build.py",
    "build:production": "python3 build.py --production",
    "check": "python3 scripts/check_site.py",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/form.browser.cjs",
    "start": "node server/index.js",
    "test:build": "python3 -m unittest discover -s test -p 'test_*.py'",
    "test:load": "node scripts/load-test.mjs",
    "queue:status": "node scripts/ops.mjs status",
    "queue:resume": "node scripts/ops.mjs resume",
    "backup": "node scripts/ops.mjs backup"
  },
  "engines": {
    "node": ">=22.16 <25"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "svix": "^2.9.1",
    "validator": "^13.15.35"
  },
  "type": "module"
}
