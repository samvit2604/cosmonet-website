# Copy to .env for LOCAL development. Never commit real secrets.
# Add production values in Render's Environment tab.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
DATA_DIR=./.data
RESEND_API_KEY=
RESEND_FROM=Cosmonet <enquiries@notify.cosmonet.ai>
LEADS_TO=hello@cosmonet.ai
HASH_SECRET=
OPS_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: enable signed delivery/bounce events in Resend, then paste its secret.
RESEND_WEBHOOK_SECRET=
# Keep true for production. Production always requires Turnstile.
TURNSTILE_REQUIRED=true
# Set false before restoring an old backup; reconcile jobs before enabling.
EMAIL_WORKER_ENABLED=true
# Explicit extra production origins, comma-separated; no wildcards.
ADDITIONAL_ORIGINS=
TRUST_PROXY_HOPS=0
